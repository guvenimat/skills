{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git switch*": "deny",
      "git checkout -b*": "deny",
      "git checkout main*": "deny",
      "git branch -d*": "deny",
      "git branch -D*": "deny",
      "git tag*": "deny",
      "git filter-branch*": "deny",
      "gh *": "deny",
      "docker compose down*": "deny",
      "docker compose * down*": "deny",
      "docker compose stop*": "deny",
      "docker compose * stop*": "deny",
      "docker compose kill*": "deny",
      "docker compose * kill*": "deny",
      "docker compose rm*": "deny",
      "docker compose * rm*": "deny",
      "docker compose restart*": "deny",
      "docker compose * restart*": "deny",
      "docker stop*": "deny",
      "docker kill*": "deny",
      "docker rm*": "deny",
      "docker volume rm*": "deny",
      "docker system prune*": "deny",
      "docker container prune*": "deny",
      "docker volume prune*": "deny",
      "rm -rf*": "deny",
      "rm -fr*": "deny",
      "*DELETE FROM*": "deny",
      "*delete from*": "deny",
      "*TRUNCATE*": "deny",
      "*truncate *": "deny",
      "*DROP TABLE*": "deny",
      "*drop table*": "deny",
      "*DROP DATABASE*": "deny",
      "*drop database*": "deny",
      "*ALTER TABLE*": "deny",
      "*alter table*": "deny",
      "*UPDATE * SET *": "deny",
      "*update * set *": "deny"
    }
  }
}